{
  "compilerOptions": {

    "target": "ES2022",

    "module": "commonjs",

    "lib": [
      "ES2022",
      "DOM"
    ],

    "strict": true,

    "noImplicitAny": true,

    "esModuleInterop": true,

    "resolveJsonModule": true,

    "moduleResolution": "bundler",

    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,

    "types": [
      "node",
      "@playwright/test"
    ]

  },

  "include": [
    "**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "test-results",
    "playwright-report",
    "reports",
    ".features-gen"
  ]
}
